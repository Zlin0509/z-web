# Set production values through Sites environment settings, all as secrets.
TRADING_OWNER_EMAIL=owner@example.com
ALPHA_VANTAGE_API_KEY=
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Legacy credentials are used only for the explicitly selected account mode.
OKX_ACCOUNT_MODE=demo
DEEPSEEK_API_KEY=
# Set an available model from your DeepSeek account; no fixed model assumed.
DEEPSEEK_MODEL=
# Separate demo and live keys; demo keys must be created in OKX Demo Trading.
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=
OKX_REGION=global
OKX_LIVE_TRADING_ENABLED=false

# Service encryption key is provisioned in Sites; never rotate without re-encrypting saved credentials.
CONFIG_ENCRYPTION_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_LIVE_TRADING_ENABLED=false
